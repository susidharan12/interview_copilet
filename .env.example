# Interview Copilot - Environment Configuration

# Backend
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_copilot

# Redis
REDIS_URL=redis://localhost:6379/0

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=
DEFAULT_MODEL=gpt-4.1-nano
REASONING_MODEL=gpt-4.1
CODING_MODEL=gpt-4.1
EMBEDDING_MODEL=text-embedding-3-small
TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Pinecone (optional, for vector)
PINECONE_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Retention
TRANSCRIPT_RETENTION_DAYS=7
AUDIO_RETENTION_HOURS=24

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:1420"]

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
